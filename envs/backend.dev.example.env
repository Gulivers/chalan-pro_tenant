# Correo transaccional (Hostinger SMTP / buzón noreply@jobrhythm.net)
# EMAIL_HOST=smtp.hostinger.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_USE_TLS=False
# EMAIL_HOST_USER=noreply@jobrhythm.net
# EMAIL_HOST_PASSWORD="contraseña-del-buzón"
# EMAIL_DEFAULT_FROM=noreply@jobrhythm.net

# Bandeja que recibe el formulario de contacto de la landing (getjobrhythm.com)
# LANDING_CONTACT_TO_EMAIL=team@jobrhythm.net

# Cloudflare Turnstile (onboarding CAPTCHA)
# Test keys (always pass): site=1x00000000000000000000AA secret=1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# ONBOARDING_VERIFY_EXPIRY_HOURS=24

# Stripe (JobRhythm appbilling — public schema)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook producción: https://api.jobrhythm.net/stripe/webhook/
# STRIPE_SUCCESS_URL=
# STRIPE_CANCEL_URL=
# STRIPE_CUSTOMER_PORTAL_RETURN_URL=
# BILLING_PAST_DUE_GRACE_DAYS=7
# BILLING_ENFORCEMENT_ENABLED=True
# STRIPE_STARTER_PRODUCT_ID=
# STRIPE_STARTER_PRICE_MONTHLY=
# STRIPE_STARTER_PRICE_YEARLY=
# STRIPE_PROFESSIONAL_PRODUCT_ID=
# STRIPE_PROFESSIONAL_PRICE_MONTHLY=
# STRIPE_PROFESSIONAL_PRICE_YEARLY=
# STRIPE_ENTERPRISE_PRODUCT_ID=
# STRIPE_ENTERPRISE_PRICE_MONTHLY=
# STRIPE_ENTERPRISE_PRICE_YEARLY=

# Semantic search (OpenAI text-embedding-3-small, 1536 dims)
# ChatGPT Pro no incluye acceso API: crear clave en https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...
# SEARCH_EMBEDDING_MODEL=text-embedding-3-small
# SEARCH_EMBEDDING_DIMENSIONS=1536
# SEARCH_INDEXING_ENABLED=True
# SEARCH_INDEX_BATCH_SIZE=50
