#!/usr/bin/expect -f

set timeout 30
set password "13694344Ho$"
set pubkey_file [lindex $argv 0]

spawn ssh-copy-id -i $pubkey_file ubuntu@72.60.168.62
expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    "yes/no" {
        send "yes\r"
        exp_continue
    }
    eof
}
