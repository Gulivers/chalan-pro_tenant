# Ignore virtual environment
venv/

# Ignore node_modules
app/vuefrontend/node_modules/
app/vuefrontend/dist/
node_modules/

# Ignore build artifacts and logs
*.log
*.log.*

# Ignore Python cache files
__pycache__/
.DS_Store
*.pyc
*.pyo

# Ignore system files
.DS_Store

# Ignore .env files (con secretos) - CRÍTICO
.env
.env_mysql
envs/*.env
!envs/*.example.env
!envs/*.dev.example.env

# Ignore IDE
.idea/
.cursor/
*.swp

# Ignore VisualStudioCode (excepto configuraciones útiles)
.vscode/
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# Ignore database data - CRÍTICO
postgres_data/
pgadmin_data/

# Ignore SSL certificates (solo en producción)
# /etc/letsencrypt/ (comentado, no está en el repo)

# Ignore migrations (si no quieres commitearlas)
# app/ctrctsapp/migrations/*
# !app/ctrctsapp/migrations/__init__.py
# (repetir para cada app según necesidad)

# Ignore Vue env files
app/vuefrontend/.env.local
app/vuefrontend/.env

# Ignore workspace files (específicos de máquina/servidor)
*.code-workspace

# Ignore reglas Cursor solo para este servidor (VPS)
.cursor/rules/devops-vps.mdc

# Ignore readme directory except specific files
readme/*
!readme/README_RESUMEN_GENERAL.md

# Ignore certbot directory
certbot/

# Ignore backups directory
backups/
scripts/backup_completo.sh
scripts/backup_local.sh
scripts/restore_backup.sh

# Scripts de backup/restore (específicos del VPS, no sincronizar)
scripts/backup_completo_VPS.sh
scripts/restore_backup_VPS.sh

# Scripts locales de sincronización/deploy en ubuntu_house (no subir a remoto)
scripts/sync_local_branches.sh
scripts/deploy_to_hostinger.sh
scripts/sync_local_prepare_deploy.sh
scripts/sync_main_with_remote.sh
